# Copy to .env and fill in your values:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Mac/Linux)

# Required — Google AI Studio / Gemini API key
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional — Gemini model (default: gemini-2.5-flash)
# If you get quota errors, try: gemini-2.5-flash or gemini-2.0-flash-lite
GEMINI_MODEL=gemini-2.5-flash

# Optional — keep replies short (token savings)
# Use 2048+ for gemini-2.5-flash (512 truncates answers to one line)
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TEMPERATURE=0.4

# Optional — where Chroma persists vectors (relative to project root)
CHROMA_PERSIST_DIR=./data/chroma_db

# Optional — collection name inside Chroma
CHROMA_COLLECTION=eshwar_knowledge

# Optional — local embedding model (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional — RAG retrieval count
RAG_TOP_K=3

# Optional — Chroma distance threshold (lower score = better match; above = weak)
RAG_SCORE_THRESHOLD=1.15

# Optional — chunk size for ingestion (smaller = more focused retrieval)
CHUNK_SIZE=500
CHUNK_OVERLAP=50
